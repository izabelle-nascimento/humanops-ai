
[run]
source = .
branch = False
relative_files = True

omit =
    */tests/*
    */.venv/*
    */venv/*
    */site-packages/*
    */htmlcov/*

[report]
show_missing = True
precision = 2

exclude_lines =
    pragma: no cover
    if __name__ == .__main__.:

[html]
directory = htmlcov
title = HumanOps AI - Code Coverage Report
